# Базовый URL испытуемого сервера обучения (обязательно).
TRAINING_SERVER_BASE_URL=https://energomera.ai-center.online

# Таймаут обычных запросов, секунды.
TRAINING_SERVER_TIMEOUT=15

# Таймаут скачивания файлов, секунды (сервер не поддерживает Range и отдаёт файл целиком).
TRAINING_SERVER_DOWNLOAD_TIMEOUT=600

# Порог размера файла (МБ), выше которого скачивание требует подтверждения оператора.
TRAINING_SERVER_DOWNLOAD_LIMIT_MB=200

# --- Настройки пульта испытаний -------------------------------------------------

# Уровень журналирования: DEBUG | INFO | WARNING | ERROR.
PULT_LOG_LEVEL=INFO

# Сохранять ли тела HTTP-запросов/ответов в журнал (true/false).
# При false фиксируются только метаданные (метод, путь, статус, размеры, длительность).
PULT_LOG_BODIES=true

# Лимит сохраняемого тела (символов); всё, что длиннее, помечается как усечённое.
PULT_BODY_LIMIT=4096

# Максимум записей журнала HTTP в памяти за сессию приложения.
PULT_JOURNAL_MAX=5000

# Интервал поллинга задач, секунды (используется монитором задач, этап T4).
PULT_POLL_INTERVAL=2.0

# Асинхронная запись журналов (true/false). По умолчанию false: журнал испытаний
# является доказательством и не должен теряться при аварийном завершении процесса.
PULT_LOG_ENQUEUE=false
